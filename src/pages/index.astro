---
// Static catalog with progressively enhanced category and publisher filters.
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form id="game-filters" aria-label="Filter games" hidden
            class="mb-6 rounded-xl border border-slate-700 bg-slate-800 p-6">
            <fieldset aria-describedby="category-filter-help">
              <legend class="font-semibold text-slate-100">Categories</legend>
              <p id="category-filter-help" class="mt-2 text-sm text-slate-300">
                Choose one or more categories. Games matching any selected category are shown.
              </p>
              <div class="mt-3 flex flex-wrap gap-4">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-slate-200">
                    <input type="checkbox" name="category" value={category.id}
                      data-testid={`category-filter-${category.id}`}
                      aria-controls="games-grid"
                      class="h-4 w-4 rounded accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>
            <div class="mt-5 flex flex-col items-start gap-4 sm:flex-row sm:items-end">
              <div class="w-full sm:w-auto">
                <label for="publisher-filter" class="mb-2 block font-semibold text-slate-100">Publisher</label>
                <select id="publisher-filter" name="publisher" data-testid="publisher-filter"
                  aria-controls="games-grid"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 p-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>
              <button type="reset" data-testid="clear-filters"
                class="rounded-lg border border-slate-600 px-4 py-2 text-slate-100 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                Clear filters
              </button>
            </div>
          </form>
          <p id="filter-results" role="status" aria-live="polite" aria-atomic="true"
            data-testid="filter-results" class="mb-4 text-slate-300">
            {games.length} {games.length === 1 ? 'game' : 'games'} shown
          </p>
          <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => (
              <div data-filter-game data-category-id={game.category?.id} data-publisher-id={game.publisher?.id}>
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div id="filter-empty-state" hidden>
            <EmptyState text="No games match your filters. Try another category or publisher, or clear filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');

  if (form) {
    const publisher = form.querySelector<HTMLSelectElement>('#publisher-filter');
    const categoryInputs = form.querySelectorAll<HTMLInputElement>('input[name="category"]');
    const cards = document.querySelectorAll<HTMLElement>('[data-filter-game]');
    const results = document.getElementById('filter-results');
    const emptyState = document.getElementById('filter-empty-state');

    if (!publisher || !results || !emptyState) {
      throw new Error('Catalog filter controls or result elements are missing.');
    }

    const updateGames = (): void => {
      const categoryIds = Array.from(categoryInputs)
        .filter((input) => input.checked)
        .map((input) => input.value);
      let count = 0;

      for (const card of cards) {
        const matchesCategory = categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
        const matchesPublisher = publisher.value === '' || card.dataset.publisherId === publisher.value;
        card.hidden = !(matchesCategory && matchesPublisher);
        if (!card.hidden) count++;
      }

      results.textContent = `${count} ${count === 1 ? 'game' : 'games'} shown`;
      emptyState.hidden = count !== 0;
    };

    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('change', updateGames);
    form.addEventListener('reset', (event) => {
      event.preventDefault();
      for (const input of categoryInputs) input.checked = false;
      publisher.value = '';
      updateGames();
    });
    updateGames();
    form.hidden = false;
  }
</script>
